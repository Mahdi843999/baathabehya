<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mon audio</title>

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background: #f2f2f2;
        }

        .box {
            width: 90%;
            max-width: 500px;
            background: white;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
            text-align: center;
        }

        h1 {
            margin-bottom: 25px;
        }

        audio {
            width: 100%;
        }
    </style>
</head>

<body>

    <div class="box">

        <h1>🎵 Mon audio</h1>

        <audio controls>
            <source src="mon_audio.wav" type="audio/wav">
            Votre navigateur ne prend pas en charge la lecture audio.
        </audio>

    </div>

</body>

</html>
